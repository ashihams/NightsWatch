# Mock CRM tools (default matches npm run tools)
TOOLS_BASE_URL=http://localhost:5678

# TensorMux — OpenAI-compatible gateway for ALL LLM calls
# Leave blank (or omit) to use the deterministic offline planner fallback.
TENSORMUX_BASE_URL=https://your-tensormux-host/v1
TENSORMUX_API_KEY=your-tensormux-api-key
TENSORMUX_MODEL=gpt-4o-mini

# Optional: max planner steps before stopping
AGENT_MAX_STEPS=8
