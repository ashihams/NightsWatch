# Mock CRM tools (default matches npm run tools)
TOOLS_BASE_URL=http://localhost:5678

# TensorMux — OpenAI-compatible gateway for ALL LLM calls
# Leave blank (or omit) to use the deterministic offline planner fallback.
TENSORMUX_BASE_URL=https://your-tensormux-host/v1
TENSORMUX_API_KEY=your-tensormux-api-key
TENSORMUX_MODEL=gpt-4o-mini
# Local Ollama via infra/tensormux (port 8090):
# TENSORMUX_BASE_URL=http://127.0.0.1:8090/v1
# TENSORMUX_API_KEY=local-dev
# TENSORMUX_MODEL=qwen2.5:1.5b

# Optional: max planner steps before stopping
AGENT_MAX_STEPS=8

# Working memory (SQLite) — one in-flight / recent planner run
# Default: ./data/working.sqlite (gitignored under data/)
WORKING_DB_PATH=./data/working.sqlite

# Episodic memory (SQLite vector store) — situation+outcome embeddings per run
# Choice: local SQLite + JSON float vectors + in-process cosine search (zero infra).
# Default embeddings: deterministic bag-of-words hash (no paid API). Optional API below.
# Default path: ./data/episodic.sqlite (gitignored under data/)
EPISODIC_DB_PATH=./data/episodic.sqlite
# Top-k nearest episodes injected as soft context when no semantic lessons yet
EPISODIC_RETRIEVE_K=3

# Optional OpenAI-compatible embeddings (TensorMux or other). Leave blank for offline hash.
# If set but the call fails, the agent falls back to offline bag-of-words embeddings.
# EMBEDDING_BASE_URL=https://your-tensormux-host/v1
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_MODEL=text-embedding-3-small

# Neatlogs / OpenTelemetry — LLM + tool + agent spans
# Get an API key from https://app.neatlogs.com
# If NEATLOGS_API_KEY is missing, the agent still runs; tracing is skipped with a warning.
# When set, the post-run analyzer prefers reading TOOL spans via the Neatlogs MCP
# session/trace API; if that read fails, it falls back to working-memory tool_call_log.
NEATLOGS_API_KEY=your-neatlogs-api-key
# Optional ingest endpoint (SDK default: https://ingest.neatlogs.com)
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
# Optional MCP URL (default: {NEATLOGS_ENDPOINT}/mcp)
# NEATLOGS_MCP_URL=https://ingest.neatlogs.com/mcp
# Optional workflow label in the Neatlogs dashboard (default: support-agent-planner)
NEATLOGS_WORKFLOW_NAME=support-agent-planner
# Post-flush MCP search poll (ms) — analyzer waits for index before falling back
# NEATLOGS_READ_WAIT_MS=20000
# NEATLOGS_READ_POLL_MS=1500
# NEATLOGS_FLUSH_INTERVAL=1

# Pending reflection records. Written when analyzer flagged=true; marked reflected after Step 7.
# Default: ./data/pending_reflection/{run_id}.json
PENDING_REFLECTION_DIR=./data/pending_reflection

# Neo4j semantic memory (Step 7) — AuraDB-friendly bolt/neo4j+s URI
# Leave blank to use the local JSON fallback store (demos / offline).
# If URI is set but Neo4j is unreachable, the agent logs a warning and falls back — no crash.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# Local fallback when Neo4j unset/unreachable (default ./data/semantic_lessons.json)
SEMANTIC_FALLBACK_PATH=./data/semantic_lessons.json

# Strategy injection (Step 8) — retrieve usable lessons at run start
# STRATEGY_INJECTION=1 (default) enables; set 0/false to force episodic-only / naive demos
STRATEGY_INJECTION=1
# Minimum lesson confidence for direct-match path (usable lessons are still eligible via shared-factor)
STRATEGY_MIN_CONFIDENCE=0.55
# Fraction of query factors that must overlap for "direct" vs "shared_factor" path
STRATEGY_DIRECT_OVERLAP=0.5
# Max usable lessons to inject
STRATEGY_TOP_K=3

# Demo dashboard (Step 10) — default http://localhost:3847
# DASHBOARD_PORT=3847

