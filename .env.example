# Mock CRM tools (default matches npm run tools)
TOOLS_BASE_URL=http://localhost:5678

# TensorMux — OpenAI-compatible gateway for ALL LLM calls
# Leave blank (or omit) to use the deterministic offline planner fallback.
TENSORMUX_BASE_URL=https://your-tensormux-host/v1
TENSORMUX_API_KEY=your-tensormux-api-key
TENSORMUX_MODEL=gpt-4o-mini

# Optional: max planner steps before stopping
AGENT_MAX_STEPS=8

# Working memory (SQLite) — one in-flight / recent planner run
# Default: ./data/working.sqlite (gitignored under data/)
WORKING_DB_PATH=./data/working.sqlite

# Episodic memory (SQLite vector store) — situation+outcome embeddings per run
# Choice: local SQLite + JSON float vectors + in-process cosine search (zero infra).
# Default embeddings: deterministic bag-of-words hash (no paid API). Optional API below.
# Default path: ./data/episodic.sqlite (gitignored under data/)
EPISODIC_DB_PATH=./data/episodic.sqlite
# Top-k nearest episodes injected as soft context when no semantic lessons yet
EPISODIC_RETRIEVE_K=3

# Optional OpenAI-compatible embeddings (TensorMux or other). Leave blank for offline hash.
# If set but the call fails, the agent falls back to offline bag-of-words embeddings.
# EMBEDDING_BASE_URL=https://your-tensormux-host/v1
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_MODEL=text-embedding-3-small

# Neatlogs / OpenTelemetry — LLM + tool + agent spans
# Get an API key from https://app.neatlogs.com
# If NEATLOGS_API_KEY is missing, the agent still runs; tracing is skipped with a warning.
NEATLOGS_API_KEY=your-neatlogs-api-key
# Optional ingest endpoint (SDK default: https://ingest.neatlogs.com)
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
# Optional workflow label in the Neatlogs dashboard (default: support-agent-planner)
NEATLOGS_WORKFLOW_NAME=support-agent-planner
