{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{dashboard/fixtures/**,dashboard/public/**,agent/src/**,scripts/**,tools/mock-server/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
